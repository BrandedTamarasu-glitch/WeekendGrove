# Copy to a private .env file. Never commit the real configuration or data.
# These defaults retain PC localhost access. Choose actual Unraid values later.
GROVE_IMAGE=weekend-grove:local
GROVE_BIND_IP=127.0.0.1
GROVE_PORT=8765
GROVE_ALLOWED_HOSTS=localhost,127.0.0.1
# Required only for compose.unraid.yaml: absolute, existing, healthy storage.
# Example SHAPE only: /mnt/CONFIRMED_POOL/appdata/weekend-grove
# Leave blank until the actual directory has been chosen and created.
GROVE_APPDATA_PATH=

# Optional compose.providers.yaml: private host directory, outside this checkout.
# Contains geoapify.key and optionally ticketmaster.key; never put keys here.
GROVE_SECRETS_PATH=

# Optional compose.backups.yaml only after choosing/approving a dedicated folder.
# GROVE_BACKUP_PATH=/absolute/path/to/existing/dedicated-backups
# Scheduling and retention deletion remain off until explicitly approved in Settings.
